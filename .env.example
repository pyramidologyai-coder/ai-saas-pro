# ============================================================
# REQUIRED — App will throw on startup if any of these are missing
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini AI
GOOGLE_AI_API_KEY=your_gemini_api_key

# Meta / WhatsApp Business API
META_ACCESS_TOKEN=your_meta_access_token
META_VERIFY_TOKEN=your_random_webhook_verify_token_min_32_chars

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Master Vault — protects /super-admin route
# Generate with: openssl rand -hex 32
MASTER_VAULT_KEY=generate_a_strong_random_secret_here

# Super Admin Emails (comma-separated, no spaces)
# Used server-side (actions.ts) — do NOT expose to browser via NEXT_PUBLIC unless needed
SUPER_ADMIN_EMAILS=admin@yourdomain.com
# Used client-side for UI gating only (not a security boundary)
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=admin@yourdomain.com

# ============================================================
# OPTIONAL
# ============================================================

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Stripe Connect (for agencies)
STRIPE_CONNECT_CLIENT_ID=ca_...

# Test Accounts (Demo Provisioning)
TEST_AGENCY_EMAIL=agency.demo@reportclinics.app
TEST_AGENCY_PASSWORD=replace-with-a-strong-password
TEST_TENANT_EMAIL=tenant.demo@reportclinics.app
TEST_TENANT_PASSWORD=replace-with-a-strong-password
