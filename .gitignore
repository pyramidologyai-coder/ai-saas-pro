# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local executor bridge
.antigravity-bridge/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# local session notes / scratch DB scripts
/CHANGES_THIS_SESSION.md
/scratch_*.js
/check_*.js
/check-*.js
/fix_*.js
/test-*.js
/test_*.js
/run_test_*.js
/update_token.js

# compiled TypeScript artifacts under src/lib; keep source in .ts files
/src/lib/*.js
